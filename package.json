{
  "name": "adknot-ai",
  "private": true,
  "scripts": {
    "build": "react-router build",
    "dev": "shopify app dev",
    "config:link": "shopify app config link",
    "generate": "shopify app generate",
    "deploy": "shopify app deploy",
    "config:use": "shopify app config use",
    "env": "shopify app env",
    "start": "react-router-serve ./build/server/index.js",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "docker-start": "npm run setup && npm run start",
    "setup": "prisma generate && prisma db push",
    "lint": "eslint --ignore-path .gitignore --cache --cache-location ./node_modules/.cache/eslint .",
    "shopify": "shopify",
    "prisma": "prisma",
    "graphql-codegen": "graphql-codegen",
    "migrate:store:approved": "node --env-file=.env scripts/migrate-database/insert-approved-store.mjs",
    "migrate:configurations": "node --env-file=.env scripts/migrate-database/prepare-configurations.mjs",
    "migrate:configurations:approved": "node --env-file=.env scripts/migrate-database/apply-configurations.mjs",
    "audit:legacy-subscriptions": "node --env-file=.env scripts/migrate-database/audit-legacy-subscriptions.mjs",
    "delete:uninstalled-test-stores": "node --env-file=.env scripts/migrate-database/delete-shops-completely.mjs",
    "prepare:subscriptions": "node --env-file=.env --env-file=../multi-sync-backend/.env scripts/migrate-database/prepare-subscriptions.mjs",
    "migrate:subscriptions:approved": "node --env-file=.env scripts/migrate-database/apply-subscriptions.mjs",
    "migrate:stores:shopify-csv:approved": "node --env-file=.env scripts/migrate-database/apply-shopify-csv-stores.mjs",
    "migrate:stores:shopify-csv": "node --env-file=.env scripts/migrate-database/prepare-shopify-csv-stores.mjs",
    "migrate:stores": "node --env-file=.env scripts/migrate-database/01-stores.mjs",
    "test:migrate:stores": "node --test scripts/migrate-database/*.test.mjs",
    "audit:cutover": "node scripts/cutover/audit-readiness.mjs",
    "audit:cutover:shopify": "node scripts/cutover/audit-readiness.mjs --validate-shopify",
    "prepare:token-exchange": "node scripts/cutover/prepare-token-exchange.mjs",
    "exchange:token": "node scripts/cutover/apply-token-exchange.mjs",
    "reset:shop-auth": "node scripts/cutover/reset-shop-auth.mjs",
    "test:cutover": "node --test scripts/cutover/*.test.mjs",
    "vite": "vite",
    "typecheck": "react-router typegen && tsc --noEmit"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19 <22 || >=22.12"
  },
  "dependencies": {
    "@multi-sync/catalog-rules": "file:packages/catalog-rules",
    "@prisma/client": "^6.16.3",
    "@react-router/dev": "^7.12.0",
    "@react-router/fs-routes": "^7.12.0",
    "@react-router/node": "^7.12.0",
    "@react-router/serve": "^7.12.0",
    "@shopify/app-bridge-react": "^4.2.4",
    "@shopify/polaris": "^13.9.5",
    "@shopify/polaris-icons": "^9.3.1",
    "@shopify/shopify-app-react-router": "^1.1.0",
    "@shopify/shopify-app-session-storage-mongodb": "^6.0.1",
    "@tanstack/react-query": "^5.101.4",
    "isbot": "^5.1.31",
    "mongodb": "^7.5.0",
    "prisma": "^6.16.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.7.0",
    "react-router": "^7.12.0",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "devDependencies": {
    "@shopify/api-codegen-preset": "^1.2.0",
    "@shopify/app-bridge-types": "^0.7.0",
    "@shopify/polaris-types": "^1.0.1",
    "@types/eslint": "^9.6.1",
    "@types/node": "^22.18.8",
    "@types/react": "^18.3.25",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "graphql-config": "^5.1.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vite": "^6.3.6"
  },
  "workspaces": [
    "extensions/*"
  ],
  "trustedDependencies": [
    "@shopify/plugin-cloudflare"
  ],
  "overrides": {
    "p-map": "^4.0.0"
  },
  "author": "User"
}
