# Use a MongoDB user with read-only access to gsf whenever possible.
SOURCE_MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/
SOURCE_DATABASE_NAME=gsf

# Use a separate read/write credential for the destination.
# Start with a disposable test database before using Multi-sync.
TARGET_MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/
TARGET_DATABASE_NAME=Multi-sync-migration-test
