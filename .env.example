# Runtime identity: use the existing Multi Sync Google Feed Shopify app.
SHOPIFY_API_KEY=<multi-sync-google-feed-client-id>
SHOPIFY_API_SECRET=<multi-sync-google-feed-client-secret>
SHOPIFY_APP_URL=https://multi-sync.fly.dev

# Keep the migrated MongoDB database and current backend service.
DATABASE_URL=<mongodb-connection-string-ending-in-/Multi-sync>
MULTI_SYNC_BACKEND_URL=https://multi-sync-server-392904571480.europe-west1.run.app

# Generate one strong value and configure the exact same value in the frontend
# and backend. Do not reuse a Shopify token.
MULTI_SYNC_INTERNAL_SECRET=<at-least-32-random-bytes>
