// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum StoreStatus {
  INSTALLED
  UNINSTALLED
}

enum StoreAccessStatus {
  ACTIVE
  SUSPENDED
}

enum SubscriptionStatus {
  UNKNOWN
  NO_SUBSCRIPTION
  TRIAL
  ACTIVE
  CANCELED
  FROZEN
  EXPIRED
}

enum CheckoutLinkMode {
  DISABLED
  CART
  CHECKOUT
}

enum InventorySourceMode {
  ALL_LOCATIONS
  SELECTED_LOCATIONS
}

enum SupportTicketStatus {
  PENDING
  OPEN
  CLOSED
}

enum SupportSenderRole {
  MERCHANT
  SUPPORT
}

model Store {
  id                     String               @id @default(auto()) @map("_id") @db.ObjectId
  shopDomain             String               @unique
  shopPlan               String?
  accessStatus           StoreAccessStatus    @default(ACTIVE)
  accessToken            String?
  status                 StoreStatus          @default(INSTALLED)
  installedAt            DateTime             @default(now())
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  uninstalledAt          DateTime?
  configuration          Configuration?
  subscription           StoreSubscription?
  xmlLinks               XmlLink[]
  attributeRuleJobs      AttributeRuleJob[]
  bulkProductTypeJobs    BulkProductTypeJob[]
  customLabels           CustomLabel[]
  feedRefreshSchedule    FeedRefreshSchedule?
  feedGenerationFeedId   String?
  feedGenerationLockedAt DateTime?
  accessTokenExpiresAt   DateTime?
  refreshToken           String?
  refreshTokenExpiresAt  DateTime?
  tokenRefreshLockId     String?
  tokenRefreshLockedAt   DateTime?
  supportTickets         SupportTicket[]

  @@index([status])
  @@index([accessStatus])
}

model SupportTicket {
  id                  String              @id @default(auto()) @map("_id") @db.ObjectId
  storeId             String              @db.ObjectId
  store               Store               @relation(fields: [storeId], references: [id], onDelete: NoAction)
  title               String
  status              SupportTicketStatus @default(PENDING)
  lastMessage         String?
  lastMessageAt       DateTime?
  messageCount        Int                 @default(0)
  merchantUnreadCount Int                 @default(0)
  supportUnreadCount  Int                 @default(1)
  firstSupportReplyAt DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  closedAt            DateTime?
  closedByRole        SupportSenderRole?
  closedById          String?
  messages            SupportMessage[]

  @@index([storeId, updatedAt])
  @@index([storeId, status, updatedAt])
  @@index([status, updatedAt])
  @@index([lastMessageAt])
}

model SupportMessage {
  id         String            @id @default(auto()) @map("_id") @db.ObjectId
  ticketId   String            @db.ObjectId
  ticket     SupportTicket     @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderRole SupportSenderRole
  senderId   String?
  senderName String?
  message    String
  createdAt  DateTime          @default(now())

  @@index([ticketId, createdAt])
}

model StoreSubscription {
  id                       String             @id @default(auto()) @map("_id") @db.ObjectId
  storeId                  String             @unique @db.ObjectId
  store                    Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  shopifyShopId            String
  planHandle               String?
  status                   SubscriptionStatus @default(UNKNOWN)
  billingPeriod            String?
  trialEndsAt              DateTime?
  currentBillingCycleStart DateTime?
  currentBillingCycleEnd   DateTime?
  cancelAtEndOfCycle       Boolean            @default(false)
  lastSyncedAt             DateTime?
  lastSyncError            String?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  @@index([status])
  @@index([planHandle])
  @@index([trialEndsAt])
}

model Configuration {
  id                                 String              @id @default(auto()) @map("_id") @db.ObjectId
  storeId                            String              @unique @db.ObjectId
  store                              Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  alertsEmail                        String
  countryCode                        String
  // Kept temporarily so existing single-value records can be migrated safely.
  colorOption                        String?
  sizeOption                         String?
  colorOptions                       String[]            @default([])
  sizeOptions                        String[]            @default([])
  optionMappingsInitialized          Boolean             @default(false)
  excludedCollections                Json
  excludedTitleTerms                 String[]
  productTypes                       String[]            @default([])
  diagnosticsRevision                String              @default("")
  showSalePriceInGoogleFeed          Boolean             @default(false)
  useProductImageAsMainImage         Boolean             @default(false)
  includeShippingWeightInGoogleFeed  Boolean             @default(false)
  excludeOutOfStockItems             Boolean             @default(false)
  ignoreShopifyInventoryInGoogleFeed Boolean             @default(false)
  inventorySourceMode                InventorySourceMode @default(ALL_LOCATIONS)
  selectedInventoryLocationIds       String[]            @default([])
  disableUtmParameters               Boolean             @default(false)
  disablePrimaryCurrencyParameter    Boolean             @default(false)
  checkoutLinkMode                   CheckoutLinkMode    @default(DISABLED)
  defaultGender                      String?
  defaultAgeGroup                    String?
  genderRules                        Json?
  ageRules                           Json?
  genderRulesVersion                 Int                 @default(0)
  ageRulesVersion                    Int                 @default(0)
  genderRulesAppliedVersion          Int                 @default(0)
  ageRulesAppliedVersion             Int                 @default(0)
  createdAt                          DateTime            @default(now())
  updatedAt                          DateTime            @updatedAt

  @@index([updatedAt])
}

enum AttributeRuleKind {
  GENDER
  AGE
}

enum AttributeRuleJobStatus {
  IDLE
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

model AttributeRuleJob {
  id                    String                 @id @default(auto()) @map("_id") @db.ObjectId
  storeId               String                 @db.ObjectId
  store                 Store                  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  kind                  AttributeRuleKind
  ruleVersion           Int
  status                AttributeRuleJobStatus @default(QUEUED)
  processedProducts     Int                    @default(0)
  totalProducts         Int?
  lastError             String?
  generationStartedAt   DateTime?
  generationCompletedAt DateTime?
  leaseOwner            String?
  leaseExpiresAt        DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@unique([storeId, kind])
  @@index([status, leaseExpiresAt])
}

model AttributeRuleMatch {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  jobId       String   @db.ObjectId
  ruleVersion Int
  productId   String
  value       String
  ruleIndex   Int
  createdAt   DateTime @default(now())

  @@unique([jobId, ruleVersion, productId])
  @@index([jobId, ruleVersion])
}

model DiagnosticsSnapshot {
  id                    String    @id @default(auto()) @map("_id") @db.ObjectId
  shop                  String
  scanVersion           String
  configurationRevision String    @default("")
  status                String
  createdAt             DateTime  @default(now())
  completedAt           DateTime?
  allProducts           Int       @default(0)
  submitted             Int       @default(0)
  warnings              Int       @default(0)
  excluded              Int       @default(0)

  @@unique([shop, scanVersion])
  @@index([shop, status, completedAt])
  @@index([shop, configurationRevision, status, completedAt])
}

model DiagnosticsSnapshotProduct {
  id                      String   @id @default(auto()) @map("_id") @db.ObjectId
  shop                    String
  scanVersion             String
  productId               String
  position                Int
  title                   String
  productCreatedAt        DateTime
  categoryName            String?
  genderValues            String[] @default([])
  genderMatchValues       String[] @default([])
  ageValues               String[] @default([])
  ageMatchValues          String[] @default([])
  colorValues             String[] @default([])
  colorMatchValues        String[] @default([])
  sizeValues              String[] @default([])
  sizeMatchValues         String[] @default([])
  vendor                  String?
  customLabel0Values      String[] @default([])
  customLabel0MatchValues String[] @default([])
  customLabel1Values      String[] @default([])
  customLabel1MatchValues String[] @default([])
  customLabel2Values      String[] @default([])
  customLabel2MatchValues String[] @default([])
  customLabel3Values      String[] @default([])
  customLabel3MatchValues String[] @default([])
  customLabel4Values      String[] @default([])
  customLabel4MatchValues String[] @default([])
  productType             String?
  tags                    String[] @default([])
  warningCodes            String[] @default([])
  warningMessages         String[] @default([])
  imageUrl                String?
  imageAlt                String?
  status                  String
  warningData             Json

  @@unique([shop, scanVersion, productId])
  @@index([shop, scanVersion, position])
  @@index([shop, scanVersion, status, position])
  @@index([shop, scanVersion, productCreatedAt, position])
  @@index([shop, scanVersion, status, productCreatedAt, position])
  @@index([shop, scanVersion, title, position])
  @@index([shop, scanVersion, status, title, position])
  @@index([shop, scanVersion, productType, position])
  @@index([shop, scanVersion, status, productType, position])
}

enum BulkProductTypeSelectionMode {
  EXPLICIT
  ALL_MATCHING
}

enum BulkProductTypeJobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  PARTIALLY_COMPLETED
  FAILED
}

enum BulkCatalogEditAction {
  PRODUCT_TYPE
  CUSTOM_LABEL
}

model BulkProductTypeJob {
  id                     String                       @id @default(auto()) @map("_id") @db.ObjectId
  storeId                String                       @db.ObjectId
  store                  Store                        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  idempotencyKey         String
  selectionMode          BulkProductTypeSelectionMode
  productIds             String[]                     @default([])
  excludedProductIds     String[]                     @default([])
  diagnosticsTab         String
  diagnosticsSearch      String                       @default("")
  diagnosticsFilterField String?
  diagnosticsFilterValue String?
  diagnosticsFilters     Json?
  snapshotVersion        String
  action                 BulkCatalogEditAction        @default(PRODUCT_TYPE)
  productType            String                       @default("")
  customLabelIndex       Int?
  customLabelValue       String?
  status                 BulkProductTypeJobStatus     @default(QUEUED)
  attemptCount           Int                          @default(0)
  requestedCount         Int
  processedCount         Int                          @default(0)
  successfulCount        Int                          @default(0)
  failedCount            Int                          @default(0)
  shopifyBulkOperationId String?
  shopifyStatus          String?
  errorSamples           String[]                     @default([])
  lastError              String?
  startedAt              DateTime?
  completedAt            DateTime?
  leaseOwner             String?
  leaseExpiresAt         DateTime?
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt

  @@unique([storeId, idempotencyKey])
  @@index([status, leaseExpiresAt])
  @@index([storeId, createdAt])
}

model CustomLabel {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  storeId      String   @db.ObjectId
  store        Store    @relation(fields: [storeId], references: [id], onDelete: NoAction)
  productId    String
  variantId    String
  customLabel0 String?
  customLabel1 String?
  customLabel2 String?
  customLabel3 String?
  customLabel4 String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([storeId, variantId])
  @@index([storeId, productId])
  @@index([storeId, customLabel0])
  @@index([storeId, customLabel1])
  @@index([storeId, customLabel2])
  @@index([storeId, customLabel3])
  @@index([storeId, customLabel4])
}

enum XmlFeedStatus {
  NOT_GENERATED
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum XmlFeedType {
  PRIMARY
  ADDITIONAL
}

enum AutomaticRefreshStatus {
  NEVER_RUN
  QUEUED
  PROCESSING
  SUCCESS
  FAILED
}

enum FeedRefreshSource {
  MANUAL
  AUTOMATIC
}

enum FeedRefreshRunStatus {
  QUEUED
  PROCESSING
  SUCCESS
  PARTIALLY_FAILED
  FAILED
}

enum FeedRefreshRunItemStatus {
  QUEUED
  PROCESSING
  SUCCESS
  FAILED
  SKIPPED
}

model FeedRefreshSchedule {
  id                      String                 @id @default(auto()) @map("_id") @db.ObjectId
  storeId                 String                 @unique @db.ObjectId
  store                   Store                  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customAutomaticRefresh  Boolean                @default(false)
  customTime              String?
  customTimezone          String?
  effectiveTime           String                 @default("00:00")
  effectiveTimezone       String                 @default("UTC")
  nextRunAt               DateTime
  lastClaimedRunAt        DateTime?
  claimToken              String?
  claimExpiresAt          DateTime?
  lastAutomaticStartedAt  DateTime?
  lastAutomaticFinishedAt DateTime?
  lastAutomaticStatus     AutomaticRefreshStatus @default(NEVER_RUN)
  lastAutomaticError      String?
  scheduleVersion         Int                    @default(1)
  storeInstalledAt        DateTime
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  runs                    FeedRefreshRun[]

  @@index([nextRunAt])
  @@index([lastAutomaticStatus])
  @@index([nextRunAt, claimExpiresAt])
}

model FeedRefreshRun {
  id              String               @id @default(auto()) @map("_id") @db.ObjectId
  storeId         String               @db.ObjectId
  scheduleId      String               @db.ObjectId
  // Uninstall cleanup removes the schedule but preserves historical run records.
  schedule        FeedRefreshSchedule  @relation(fields: [scheduleId], references: [id], onDelete: NoAction)
  scheduledFor    DateTime
  source          FeedRefreshSource
  status          FeedRefreshRunStatus @default(QUEUED)
  occurrenceKey   String               @unique
  scheduleVersion Int
  totalFeeds      Int                  @default(0)
  completedFeeds  Int                  @default(0)
  failedFeeds     Int                  @default(0)
  queueAttempts   Int                  @default(0)
  startedAt       DateTime?
  completedAt     DateTime?
  error           String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  items           FeedRefreshRunItem[]

  @@unique([storeId, scheduledFor, source])
  @@index([storeId, status])
  @@index([scheduleId, status])
}

model FeedRefreshRunItem {
  id               String                   @id @default(auto()) @map("_id") @db.ObjectId
  runId            String                   @db.ObjectId
  run              FeedRefreshRun           @relation(fields: [runId], references: [id], onDelete: Cascade)
  feedId           String                   @db.ObjectId
  feedType         XmlFeedType
  position         Int
  status           FeedRefreshRunItemStatus @default(QUEUED)
  bullJobId        String?
  generationNumber Int?
  leaseOwner       String?
  leaseExpiresAt   DateTime?
  attempts         Int                      @default(0)
  queuedAt         DateTime                 @default(now())
  startedAt        DateTime?
  completedAt      DateTime?
  error            String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@unique([runId, feedId])
  @@index([runId, position])
  @@index([runId, status])
  @@index([runId, status, leaseExpiresAt])
  @@index([feedId])
}

model XmlLink {
  id                    String            @id @default(auto()) @map("_id") @db.ObjectId
  storeId               String            @db.ObjectId
  store                 Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  feedType              XmlFeedType       @default(PRIMARY)
  marketId              String
  marketName            String
  marketSlug            String?
  countryName           String?
  countrySlug           String?
  countryCode           String?
  currencyName          String?
  currencyCode          String?
  locale                String
  languageName          String?
  storefrontUrl         String?
  token                 String            @unique
  publicUrl             String
  gcsObjectName         String?
  status                XmlFeedStatus     @default(NOT_GENERATED)
  generationSource      FeedRefreshSource @default(MANUAL)
  refreshRunId          String?           @db.ObjectId
  lastRefreshedAt       DateTime?
  fileSizeBytes         BigInt?
  lastError             String?
  generationStartedAt   DateTime?
  generationCompletedAt DateTime?
  generationNumber      Int               @default(0)
  processedProducts     Int               @default(0)
  totalProducts         Int?
  processedVariants     Int               @default(0)
  generatedItems        Int               @default(0)
  skippedItems          Int               @default(0)
  requiresRefresh       Boolean           @default(false)
  leaseOwner            String?
  leaseExpiresAt        DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@unique([storeId, marketId, countryCode, locale])
  @@index([storeId, feedType])
  @@index([storeId, status])
  @@index([status, leaseExpiresAt])
}
