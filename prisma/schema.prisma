// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id @map("_id")
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

enum StoreStatus {
  INSTALLED
  UNINSTALLED
}

model Store {
  id                     String             @id @default(auto()) @map("_id") @db.ObjectId
  shopDomain             String             @unique
  accessToken            String?
  status                 StoreStatus        @default(INSTALLED)
  installedAt            DateTime           @default(now())
  uninstalledAt          DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  configuration          Configuration?
  xmlLinks               XmlLink[]
  attributeRuleJobs      AttributeRuleJob[]
  feedGenerationFeedId   String?
  feedGenerationLockedAt DateTime?

  @@index([status])
}

model Configuration {
  id                        String   @id @default(auto()) @map("_id") @db.ObjectId
  storeId                   String   @unique @db.ObjectId
  store                     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  alertsEmail               String
  countryCode               String
  // Kept temporarily so existing single-value records can be migrated safely.
  colorOption               String?
  sizeOption                String?
  colorOptions              String[] @default([])
  sizeOptions               String[] @default([])
  optionMappingsInitialized Boolean  @default(false)
  excludedCollections       Json
  excludedTitleTerms        String[]
  diagnosticsRevision       String   @default("")
  showSalePriceInGoogleFeed Boolean  @default(false)
  defaultGender             String?
  defaultAgeGroup           String?
  genderRules               Json?
  ageRules                  Json?
  genderRulesVersion        Int      @default(0)
  ageRulesVersion           Int      @default(0)
  genderRulesAppliedVersion Int      @default(0)
  ageRulesAppliedVersion    Int      @default(0)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@index([updatedAt])
}

enum AttributeRuleKind {
  GENDER
  AGE
}

enum AttributeRuleJobStatus {
  IDLE
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

model AttributeRuleJob {
  id                    String                 @id @default(auto()) @map("_id") @db.ObjectId
  storeId               String                 @db.ObjectId
  store                 Store                  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  kind                  AttributeRuleKind
  ruleVersion           Int
  status                AttributeRuleJobStatus @default(QUEUED)
  processedProducts     Int                    @default(0)
  totalProducts         Int?
  lastError             String?
  generationStartedAt   DateTime?
  generationCompletedAt DateTime?
  leaseOwner            String?
  leaseExpiresAt        DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@unique([storeId, kind])
  @@index([status, leaseExpiresAt])
}

model AttributeRuleMatch {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  jobId       String   @db.ObjectId
  ruleVersion Int
  productId   String
  value       String
  ruleIndex   Int
  createdAt   DateTime @default(now())

  @@unique([jobId, ruleVersion, productId])
  @@index([jobId, ruleVersion])
}

model DiagnosticsSnapshot {
  id                    String    @id @default(auto()) @map("_id") @db.ObjectId
  shop                  String
  scanVersion           String
  configurationRevision String    @default("")
  status                String
  createdAt             DateTime  @default(now())
  completedAt           DateTime?
  allProducts           Int       @default(0)
  submitted             Int       @default(0)
  warnings              Int       @default(0)
  excluded              Int       @default(0)

  @@unique([shop, scanVersion])
  @@index([shop, status, completedAt])
  @@index([shop, configurationRevision, status, completedAt])
}

model DiagnosticsSnapshotProduct {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  shop        String
  scanVersion String
  productId   String
  position    Int
  title       String
  imageUrl    String?
  imageAlt    String?
  status      String
  warningData Json

  @@unique([shop, scanVersion, productId])
  @@index([shop, scanVersion, position])
  @@index([shop, scanVersion, status, position])
}

enum XmlFeedStatus {
  NOT_GENERATED
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum XmlFeedType {
  PRIMARY
  ADDITIONAL
}

model XmlLink {
  id                    String        @id @default(auto()) @map("_id") @db.ObjectId
  storeId               String        @db.ObjectId
  store                 Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  feedType              XmlFeedType   @default(PRIMARY)
  marketId              String
  marketName            String
  marketSlug            String?
  countryName           String?
  countrySlug           String?
  countryCode           String?
  currencyName          String?
  currencyCode          String?
  locale                String
  languageName          String?
  storefrontUrl         String?
  token                 String        @unique
  publicUrl             String
  gcsObjectName         String?
  status                XmlFeedStatus @default(NOT_GENERATED)
  lastRefreshedAt       DateTime?
  fileSizeBytes         BigInt?
  lastError             String?
  generationStartedAt   DateTime?
  generationCompletedAt DateTime?
  generationNumber      Int           @default(0)
  processedProducts     Int           @default(0)
  totalProducts         Int?
  processedVariants     Int           @default(0)
  generatedItems        Int           @default(0)
  skippedItems          Int           @default(0)
  requiresRefresh       Boolean       @default(false)
  leaseOwner            String?
  leaseExpiresAt        DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@unique([storeId, marketId, countryCode, locale])
  @@index([storeId, feedType])
  @@index([storeId, status])
  @@index([status, leaseExpiresAt])
}
